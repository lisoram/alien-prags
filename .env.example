# Copy to .env and fill in. Never commit .env.

# --- Backend (read by app/core/config.py) ---
# For `uv run` on your machine use localhost. Docker Compose overrides
# DATABASE_URL and QDRANT_URL with the in-network hostnames automatically.
DATABASE_URL=postgresql+psycopg://research:change-me@localhost:5434/research
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=
GEMINI_API_KEY=your-gemini-api-key
GEMINI_GENERATION_MODEL=your-generation-model-name
GEMINI_EMBEDDING_MODEL=your-embedding-model-name
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=INFO
# Folder containing the domain packs. Relative to where the backend runs
# (../domains from backend/). Docker Compose overrides this to /app/domains.
DOMAINS_DIR=../domains
# DEV ONLY - DO NOT ENABLE IN PRODUCTION. Lets a domain with `enabled: true` go live
# without a passing eval run, so you can test locally before Module 9 exists.
ALLOW_UNEVALUATED_DOMAINS=false

# --- Used by Docker Compose only (the app does not read these) ---
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB must match DATABASE_URL above.
POSTGRES_USER=research
POSTGRES_PASSWORD=change-me
POSTGRES_DB=research
# Host ports (chosen to avoid other projects on this machine; containers still use standard ports).
POSTGRES_HOST_PORT=5434
QDRANT_HOST_PORT=6335
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3001
# URL the BROWSER uses to reach the backend (baked into the frontend build).
NEXT_PUBLIC_API_URL=http://localhost:8000
